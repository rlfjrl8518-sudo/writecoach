# Supabase (클라우드 동기화·로그인) — NEXT_PUBLIC_* 는 빌드 시점에 필요
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 우리말샘(표준국어대사전) API 키 — 서버 전용
KORDIC_API_KEY=

# GCP Vertex AI (서버측 AI). 로컬은 ADC: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=write-coach
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=        # AI Studio 키를 쓰면 Vertex 대신 이것을 사용
# AI_DISABLED=1          # 서버 AI 끄기 (/api/ai 가 503 AI_OFF)
