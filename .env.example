# Supabase (클라우드 동기화·로그인) — NEXT_PUBLIC_* 는 빌드 시점에 필요
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 우리말샘(표준국어대사전) API 키 — 서버 전용
KORDIC_API_KEY=

# GCP Vertex AI (서버측 AI). 로컬은 ADC: gcloud auth application-default login
GOOGLE_CLOUD_PROJECT=write-coach
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.8-flash
# GEMINI_API_KEY=        # AI Studio 키를 쓰면 Vertex 대신 이것을 사용
# AI_DISABLED=1          # 서버 AI 끄기 (/api/ai 가 503 AI_OFF)
SYNC_BUCKET=write-coach-sync
# SYNC_DEV_USER=dev-local@writecoach   # 로컬 개발 전용(운영은 IAP 헤더 사용)

# Web Push (묵당의 저녁 종) — npx web-push generate-vapid-keys --json 으로 생성
# 비공개 키는 운영에서 Secret Manager vapid-private-key 로 주입 (deploy.sh SETUP=1)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
