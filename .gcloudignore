# gcloud run deploy --source 업로드 제외 목록 (.gitignore 대신 명시)
.gcloudignore
.git
node_modules
.next
*.tar.gz
*.tsbuildinfo
.env
.env.local
.env*.local
scripts/*
!scripts/push-cron.mjs
supabase-setup.sql
public/sw.js
public/sw.js.map
public/workbox-*.js
public/workbox-*.js.map
public/worker-*.js
public/fallback-*.js
